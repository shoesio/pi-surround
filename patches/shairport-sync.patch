diff --git a/ap2_latency.h b/ap2_latency.h
new file mode 100644
--- /dev/null
+++ b/ap2_latency.h
@@ -0,0 +1,26 @@
+#ifndef SHAIRPORT_AP2_LATENCY_H
+#define SHAIRPORT_AP2_LATENCY_H
+#include <stdint.h>
+typedef struct {
+  int32_t net_latency;
+  double effective_offset;
+  int rejected;
+} ap2_latency_result;
+/* An infeasible realtime offset is local to that stream, never global config. */
+static inline ap2_latency_result ap2_realtime_latency(int32_t source_latency,
+                                                     int input_rate,
+                                                     double requested_offset) {
+  ap2_latency_result r = {source_latency + (int32_t)(requested_offset * input_rate),
+                          requested_offset, 0};
+  if (r.net_latency <= 0) {
+    r.net_latency = source_latency;
+    r.effective_offset = 0.0;
+    r.rejected = 1;
+  }
+  return r;
+}
+static inline double ap2_stream_offset(int realtime, double realtime_offset,
+                                        double requested_offset) {
+  return realtime ? realtime_offset : requested_offset;
+}
+#endif
