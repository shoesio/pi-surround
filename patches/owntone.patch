 int
 input_read(void *data, size_t size, short *flag, void **flagdata)
 {
   struct marker *marker;
   int len;
+  uint8_t old_head[1920]; /* 10 ms of stereo PCM16 */
+  size_t fade_bytes = 0;
 
   *flag = 0;
 
   pthread_mutex_lock(&input_buffer.mutex);
+
+  if (input_buffer.live_target_bytes)
+    {
+      size_t queued = evbuffer_get_length(input_buffer.evbuf);
+      size_t before_marker = SIZE_MAX;
+      marker = input_buffer.marker_tail;
+      if (marker)
+        before_marker = marker->pos > input_buffer.bytes_read
+          ? marker->pos - input_buffer.bytes_read : 0;
+      size_t drop = ha_live_drop(queued, input_buffer.live_target_bytes, before_marker);
+      if (drop)
+        {
+          size_t wanted = size < sizeof(old_head) ? size : sizeof(old_head);
+          if (wanted > before_marker - drop)
+            wanted = before_marker - drop;
+          wanted -= wanted % 4;
+          if (wanted && evbuffer_copyout(input_buffer.evbuf, old_head, wanted) == (int)wanted)
+            fade_bytes = wanted;
+          evbuffer_drain(input_buffer.evbuf, drop);
+          input_buffer.bytes_read += drop;
+          DPRINTF(E_LOG, L_PLAYER, "HomeAmbient live input: trimmed %zu ms, queue now %zu ms\n",
+            drop / 192, (queued - drop) / 192);
+        }
+      if (++input_buffer.live_log_ticks >= 1000)
+        {
+          input_buffer.live_log_ticks = 0;
+          DPRINTF(E_LOG, L_PLAYER, "HomeAmbient live input: queue %zu ms, target %zu ms\n",
+            evbuffer_get_length(input_buffer.evbuf) / 192, input_buffer.live_target_bytes / 192);
+        }
+    }
 
