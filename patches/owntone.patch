+void
+input_live_buffer_configure(int milliseconds)
+{
+  pthread_mutex_lock(&input_buffer.mutex);
+  input_buffer.live_target_bytes = (milliseconds >= 100 && milliseconds <= 500)
+    ? (size_t)milliseconds * 192 : 0;
+  input_buffer.live_log_ticks = 0;
+  pthread_mutex_unlock(&input_buffer.mutex);
+}
