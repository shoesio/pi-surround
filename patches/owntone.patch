diff --git a/src/homeambient_live_buffer.h b/src/homeambient_live_buffer.h
new file mode 100644
--- /dev/null
+++ b/src/homeambient_live_buffer.h
@@ -0,0 +1,50 @@
+/* Pi Surround local modifications, 2026-10-23; see docs/UPSTREAM.md. */
+/* Home Ambient live PCM queue helpers. GPL-2.0-or-later, like OwnTone. */
+#ifndef HOMEAMBIENT_LIVE_BUFFER_H
+#define HOMEAMBIENT_LIVE_BUFFER_H
+#include <stddef.h>
+#include <stdint.h>
+
+/* Fixed 48 kHz stereo PCM16: 192 bytes per millisecond, 4 per frame.
+ * Leave 80 ms hysteresis for normal delivery bursts. Never cross a marker. */
+static inline size_t
+ha_live_drop(size_t queued, size_t target, size_t before_marker)
+{
+  size_t drop;
+  if (!target || queued <= target || queued - target <= 80 * 192)
+    return 0;
+  drop = queued - target;
+  if (drop > before_marker)
+    drop = before_marker;
+  return drop - drop % 4;
+}
+
+static inline int32_t
+ha_pcm16_read(const uint8_t *p)
+{
+  uint32_t value = (uint32_t)p[0] | ((uint32_t)p[1] << 8);
+  return value >= 32768 ? (int32_t)value - 65536 : (int32_t)value;
+}
+
+/* Blend the old head into the new head after a rare catch-up. No allocation,
+ * channel swapping, or discontinuous jump at the beginning of the splice. */
+static inline void
+ha_live_crossfade(uint8_t *current, const uint8_t *old, size_t bytes)
+{
+  size_t frames = bytes / 4;
+  if (frames < 2)
+    return;
+  for (size_t frame = 0; frame < frames; frame++)
+    for (size_t channel = 0; channel < 2; channel++)
+      {
+        size_t index = frame * 4 + channel * 2;
+        int32_t a = ha_pcm16_read(old + index);
+        int32_t b = ha_pcm16_read(current + index);
+        int32_t sample = (int32_t)(((int64_t)a * (int64_t)(frames - 1 - frame)
+                        + (int64_t)b * (int64_t)frame) / (int64_t)(frames - 1));
+        uint16_t bits = (uint16_t)sample;
+        current[index] = bits & 255;
+        current[index + 1] = bits >> 8;
+      }
+}
+#endif
