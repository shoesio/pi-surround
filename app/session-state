"""Shairport activity hook. Publishes state without privileged operations."""
import json
import os
import sys
import tempfile
import time
from pathlib import Path

if __name__ == "__main__":
    if sys.argv[1:] not in (["active"], ["inactive"]):
        raise SystemExit("Expected active or inactive")
    parent = os.getppid()
    # Include process start identity, not just a reusable PID.
    start = Path(f"/proc/{parent}/stat").read_text().rsplit(")", 1)[1].split()[19]
    payload = dict(active=sys.argv[1] == "active", pid=parent, start=start,
                   epoch=time.monotonic_ns())
    directory = "/run/homeambient-volume"
    fd, name = tempfile.mkstemp(dir=directory)
    try:
        with os.fdopen(fd, "w") as output:
            json.dump(payload, output)
        os.replace(name, directory + "/session.json")
    finally:
        if os.path.exists(name):
            os.unlink(name)
